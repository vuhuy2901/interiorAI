const __vite__css = "/*\r\n * ATELIER AI — Premium Architectural SaaS & Multi-Agent Control Plane Design System\r\n * Grounded in Leonxlnx/taste-skill (design-taste-frontend v2.5.1) + Master Prompt Section 4:\r\n * Aesthetic Direction: Paperclip-inspired Control Plane × Linear × Vercel Dashboard × Premium Architecture Studio\r\n *\r\n * Light Mode Tokens:\r\n *   App Background:    #FAFAFA\r\n *   Primary Surface:   #FFFFFF\r\n *   Secondary Surface: #F5F6F6\r\n *   Border:            #E5E7EB\r\n *   Primary Text:      #171717\r\n *   Secondary Text:    #52525B\r\n *   Accent:            #0F766E (Teal 700)\r\n *   Accent Hover:      #115E59 (Teal 800)\r\n *   Accent Soft:       #F0FDFA (Teal 50)\r\n *\r\n * Dark Mode Tokens:\r\n *   App Background:    #0A0A0B\r\n *   Primary Surface:   #111113\r\n *   Secondary Surface: #18181B\r\n *   Border:            #27272A\r\n *   Primary Text:      #FAFAFA\r\n *   Secondary Text:    #A1A1AA\r\n */\r\n\r\n:root,\r\n[data-theme='light'] {\r\n  --app-bg: #FAFAFA;\r\n  --surface-primary: #FFFFFF;\r\n  --surface-secondary: #F5F6F6;\r\n  --surface-tertiary: #EFEFEF;\r\n  --surface-overlay: rgba(255, 255, 255, 0.94);\r\n  --border-subtle: #E5E7EB;\r\n  --border-strong: #D4D4D8;\r\n  --text-primary: #171717;\r\n  --text-secondary: #52525B;\r\n  --text-muted: #71717A;\r\n  --accent: #0F766E;\r\n  --accent-hover: #115E59;\r\n  --accent-soft: #F0FDFA;\r\n  --accent-border: rgba(15, 118, 110, 0.24);\r\n\r\n  /* Semantic Status Colors (Only used for status/meaning) */\r\n  --emerald-text: #047857;\r\n  --emerald-bg: #ECFDF5;\r\n  --emerald-border: rgba(4, 120, 87, 0.22);\r\n  --amber-text: #B45309;\r\n  --amber-bg: #FFFBEB;\r\n  --amber-border: rgba(180, 83, 9, 0.24);\r\n  --rose-text: #BE123C;\r\n  --rose-bg: #FFF1F2;\r\n  --rose-border: rgba(190, 18, 60, 0.24);\r\n\r\n  --shadow-xs: 0 1px 2px rgba(23, 23, 23, 0.04);\r\n  --shadow-sm: 0 2px 6px rgba(23, 23, 23, 0.05), 0 1px 2px rgba(23, 23, 23, 0.03);\r\n  --shadow-md: 0 8px 24px rgba(23, 23, 23, 0.07), 0 2px 6px rgba(23, 23, 23, 0.04);\r\n  --shadow-drawer: -12px 0 32px rgba(23, 23, 23, 0.08);\r\n}\r\n\r\n/* Photoreal render workspace */\r\n.photoreal-page {\r\n  width: 100%; height: 100%; min-height: 0; display: flex; flex-direction: column;\r\n  color: #f6f7f8; background: #090b0d;\r\n}\r\n.photoreal-topbar {\r\n  z-index: 5; min-height: 58px; padding: 8px 14px; display: grid;\r\n  grid-template-columns: minmax(170px, 1fr) minmax(220px, 2fr) minmax(130px, 1fr);\r\n  align-items: center; gap: 12px; border-bottom: 1px solid rgba(255,255,255,.1);\r\n  background: rgba(12,14,17,.96); backdrop-filter: blur(14px);\r\n}\r\n.photoreal-title { min-width: 0; text-align: center; display: flex; flex-direction: column; gap: 2px; }\r\n.photoreal-title strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; }\r\n.photoreal-title span { color: #9ca3af; font-size: 11px; }\r\n.photoreal-icon-button {\r\n  width: max-content; min-height: 36px; padding: 0 12px; display: inline-flex; align-items: center;\r\n  justify-content: center; gap: 8px; border: 1px solid rgba(255,255,255,.13); border-radius: 10px;\r\n  color: #f4f4f5; background: rgba(255,255,255,.06); text-decoration: none; cursor: pointer;\r\n}\r\n.photoreal-icon-button:last-child { justify-self: end; }\r\n.photoreal-icon-button:hover { background: rgba(255,255,255,.11); }\r\n.photoreal-icon-button.is-disabled { opacity: .38; cursor: not-allowed; }\r\n.photoreal-stage { position: relative; flex: 1; min-height: 0; overflow: hidden; background: radial-gradient(circle at center, #25292d 0, #101316 56%, #080a0c 100%); }\r\n.photoreal-image-scroll { position: absolute; inset: 0; display: grid; place-items: center; overflow: auto; padding: 28px 28px 164px; }\r\n.photoreal-result-image { display: block; max-width: 100%; max-height: 100%; object-fit: contain; transform-origin: center; transition: transform .18s ease; box-shadow: 0 24px 80px rgba(0,0,0,.5); }\r\n.photoreal-preview-wrap { position: absolute; }.photoreal-preview-image { opacity: .82; filter: saturate(.86); }\r\n.photoreal-preview-badge { position: absolute; left: 50%; bottom: 176px; transform: translateX(-50%); padding: 7px 10px; border: 1px solid rgba(255,255,255,.16); border-radius: 999px; color: #d4d4d8; background: rgba(10,12,14,.82); font-size: 10px; white-space: nowrap; }\r\n.photoreal-empty { position: absolute; inset: 0; padding: 24px 24px 170px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }\r\n.photoreal-empty-icon { width: 62px; height: 62px; margin-bottom: 18px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.13); border-radius: 18px; color: #a7f3d0; background: rgba(16,185,129,.1); }\r\n.photoreal-empty strong { font-size: clamp(18px, 2vw, 28px); }\r\n.photoreal-empty p { max-width: 560px; margin: 9px 0 0; color: #a1a1aa; font-size: 13px; line-height: 1.55; }\r\n.photoreal-processing { position: absolute; top: 18px; left: 50%; z-index: 4; transform: translateX(-50%); display: flex; align-items: center; gap: 10px; width: min(520px, calc(100% - 32px)); padding: 12px 15px; border: 1px solid rgba(96,165,250,.35); border-radius: 12px; background: rgba(13,20,30,.9); box-shadow: 0 12px 40px rgba(0,0,0,.35); }\r\n.photoreal-processing div { display: flex; flex-direction: column; gap: 2px; }\r\n.photoreal-processing strong { font-size: 12px; }\r\n.photoreal-processing span { color: #9ca3af; font-size: 11px; }\r\n.photoreal-zoom-tools { position: absolute; right: 16px; top: 16px; z-index: 3; display: flex; align-items: center; overflow: hidden; border: 1px solid rgba(255,255,255,.12); border-radius: 10px; background: rgba(12,14,17,.82); backdrop-filter: blur(12px); }\r\n.photoreal-zoom-tools button { width: 36px; height: 36px; display: grid; place-items: center; border: 0; border-right: 1px solid rgba(255,255,255,.08); color: #f4f4f5; background: transparent; cursor: pointer; }\r\n.photoreal-zoom-tools button:hover { background: rgba(255,255,255,.1); }\r\n.photoreal-zoom-tools span { min-width: 50px; text-align: center; color: #d4d4d8; font-size: 11px; }\r\n.photoreal-controls { position: absolute; left: 50%; bottom: 18px; z-index: 5; width: min(1060px, calc(100% - 36px)); transform: translateX(-50%); border: 1px solid rgba(255,255,255,.13); border-radius: 16px; background: rgba(15,17,20,.93); box-shadow: 0 20px 70px rgba(0,0,0,.45); backdrop-filter: blur(18px); }\r\n.photoreal-controls.is-collapsed { width: auto; min-width: 180px; }\r\n.photoreal-controls-toggle { width: 100%; min-height: 30px; display: flex; align-items: center; justify-content: center; gap: 6px; border: 0; color: #a1a1aa; background: transparent; font-size: 11px; cursor: pointer; }\r\n.photoreal-controls-body { padding: 0 14px 14px; display: grid; grid-template-columns: repeat(3, minmax(125px, 1fr)) minmax(210px, 1.35fr) auto; align-items: end; gap: 10px; }\r\n.photoreal-controls label { min-width: 0; display: flex; flex-direction: column; gap: 6px; color: #a1a1aa; font-size: 11px; }\r\n.photoreal-controls select { width: 100%; min-height: 40px; padding: 0 34px 0 11px; border: 1px solid rgba(255,255,255,.13); border-radius: 9px; color: #f4f4f5; background: #181b1f; outline: none; }\r\n.photoreal-engine-state { min-width: 0; min-height: 40px; display: flex; align-items: center; gap: 9px; }\r\n.photoreal-engine-state div { min-width: 0; display: flex; flex-direction: column; gap: 2px; }\r\n.photoreal-engine-state strong, .photoreal-engine-state span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\r\n.photoreal-engine-state strong { font-size: 11px; }.photoreal-engine-state span { color: #9ca3af; font-size: 10px; }\r\n.photoreal-status-dot { flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; background: #f59e0b; box-shadow: 0 0 0 4px rgba(245,158,11,.1); }\r\n.photoreal-status-dot.is-ready { background: #34d399; box-shadow: 0 0 0 4px rgba(52,211,153,.1); }\r\n.photoreal-render-button { min-height: 42px; padding: 0 18px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 0; border-radius: 10px; color: #07110d; background: #6ee7b7; font-weight: 750; white-space: nowrap; cursor: pointer; }\r\n.photoreal-render-button:hover { background: #a7f3d0; }.photoreal-render-button:disabled { opacity: .45; cursor: not-allowed; }\r\n.photoreal-error, .photoreal-success { margin: 0 14px 12px; padding: 9px 11px; display: flex; align-items: center; justify-content: space-between; gap: 12px; border-radius: 8px; font-size: 11px; }\r\n.photoreal-error { color: #fecaca; background: rgba(127,29,29,.35); }.photoreal-success { color: #bbf7d0; background: rgba(20,83,45,.35); }\r\n.photoreal-error button { display: inline-flex; align-items: center; gap: 5px; border: 0; color: #fff; background: transparent; font-weight: 700; cursor: pointer; }\r\n.spin { animation: photoreal-spin 1s linear infinite; } @keyframes photoreal-spin { to { transform: rotate(360deg); } }\r\n@media (max-width: 900px) {\r\n  .photoreal-controls-body { grid-template-columns: repeat(2, minmax(0, 1fr)); max-height: 48vh; overflow-y: auto; }\r\n  .photoreal-engine-state { grid-column: 1 / -1; }.photoreal-render-button { grid-column: 1 / -1; }\r\n}\r\n@media (max-width: 620px) {\r\n  .photoreal-topbar { grid-template-columns: auto 1fr auto; padding: 7px 9px; }.photoreal-icon-button span { display: none; }\r\n  .photoreal-icon-button { width: 38px; padding: 0; }.photoreal-title { text-align: left; }\r\n  .photoreal-zoom-tools { right: 8px; top: 8px; }.photoreal-controls { bottom: 8px; width: calc(100% - 16px); }\r\n  .photoreal-controls-body { grid-template-columns: 1fr; }.photoreal-engine-state, .photoreal-render-button { grid-column: auto; }\r\n  .photoreal-image-scroll { padding: 16px 12px 230px; }\r\n}\r\n\r\n.delivery-playback-panel {\r\n  position: absolute;\r\n  top: 14px;\r\n  right: 14px;\r\n  z-index: 45;\r\n  width: min(310px, calc(100% - 28px));\r\n  padding: 12px;\r\n  border: 1px solid var(--accent-border);\r\n  border-radius: 12px;\r\n  background: color-mix(in srgb, var(--surface-primary) 94%, transparent);\r\n  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.18);\r\n  backdrop-filter: blur(10px);\r\n}\r\n\r\n.delivery-playback-heading {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  color: var(--text-primary);\r\n  font-size: 12px;\r\n}\r\n\r\n.delivery-playback-heading .mono { margin-left: auto; color: var(--accent); }\r\n.delivery-worker-dot { width: 9px; height: 9px; border-radius: 50%; background: #f59e0b; box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.16); }\r\n.delivery-playback-item { margin: 8px 0; color: var(--text-secondary); font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\r\n.delivery-progress-track { height: 6px; margin-bottom: 9px; overflow: hidden; border-radius: 999px; background: var(--surface-tertiary); }\r\n.delivery-progress-track > span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #0f766e, #14b8a6); transition: width 100ms linear; }\r\n\r\n.dark,\r\n[data-theme='dark'] {\r\n  --app-bg: #0A0A0B;\r\n  --surface-primary: #111113;\r\n  --surface-secondary: #18181B;\r\n  --surface-tertiary: #222226;\r\n  --surface-overlay: rgba(17, 17, 19, 0.94);\r\n  --border-subtle: #27272A;\r\n  --border-strong: #3F3F46;\r\n  --text-primary: #FAFAFA;\r\n  --text-secondary: #A1A1AA;\r\n  --text-muted: #71717A;\r\n  --accent: #14B8A6;\r\n  --accent-hover: #0D9488;\r\n  --accent-soft: rgba(20, 184, 166, 0.12);\r\n  --accent-border: rgba(20, 184, 166, 0.3);\r\n\r\n  --emerald-text: #34D399;\r\n  --emerald-bg: rgba(16, 185, 129, 0.12);\r\n  --emerald-border: rgba(52, 211, 153, 0.28);\r\n  --amber-text: #FBBF24;\r\n  --amber-bg: rgba(245, 158, 11, 0.12);\r\n  --amber-border: rgba(251, 191, 36, 0.28);\r\n  --rose-text: #FB7185;\r\n  --rose-bg: rgba(244, 63, 94, 0.12);\r\n  --rose-border: rgba(251, 113, 133, 0.28);\r\n\r\n  --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.3);\r\n  --shadow-sm: 0 2px 6px rgba(0, 0, 0, 0.4);\r\n  --shadow-md: 0 10px 28px rgba(0, 0, 0, 0.55);\r\n  --shadow-drawer: -12px 0 32px rgba(0, 0, 0, 0.65);\r\n}\r\n\r\n:root {\r\n  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\r\n  --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;\r\n\r\n  /* 4px Spacing System & Radius Tokens */\r\n  --radius-btn: 6px;\r\n  --radius-card: 8px;\r\n  --radius-panel: 10px;\r\n\r\n  /* Taste-Skill Motion Timing */\r\n  --ease-ui: cubic-bezier(0.2, 0.8, 0.2, 1);\r\n  --ease-enter: cubic-bezier(0.22, 1, 0.36, 1);\r\n  --dur-hover: 140ms;\r\n  --dur-panel: 180ms;\r\n}\r\n\r\n.atelier-surface-root {\r\n  width: 100%;\r\n  height: 100%;\r\n  background: var(--app-bg);\r\n  color: var(--text-primary);\r\n  font-family: var(--font-sans);\r\n  font-size: 13.5px;\r\n  line-height: 1.5;\r\n}\r\n\r\n/* Accessibility Skip Link */\r\n.skip-link {\r\n  position: absolute;\r\n  top: -100px;\r\n  left: 16px;\r\n  background: var(--accent);\r\n  color: #FFFFFF;\r\n  padding: 8px 14px;\r\n  border-radius: var(--radius-btn);\r\n  font-weight: 600;\r\n  z-index: 9999;\r\n  text-decoration: none;\r\n}\r\n\r\n.skip-link:focus {\r\n  top: 12px;\r\n}\r\n\r\n/* ============================================================================\r\n   APP SHELL (GLOBAL SIDEBAR + GLOBAL TOPBAR + MAIN STAGE)\r\n   ============================================================================ */\r\n.app-shell {\r\n  display: flex;\r\n  width: 100vw;\r\n  height: 100vh;\r\n  overflow: hidden;\r\n  background: var(--app-bg);\r\n}\r\n\r\n/* 5.1 Global Sidebar (236px expanded, 56px collapsed) */\r\n.global-sidebar {\r\n  width: 236px;\r\n  min-width: 236px;\r\n  height: 100vh;\r\n  background: var(--surface-primary);\r\n  border-right: 1px solid var(--border-subtle);\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  transition: width var(--dur-panel) var(--ease-ui), min-width var(--dur-panel) var(--ease-ui);\r\n  z-index: 40;\r\n  user-select: none;\r\n}\r\n\r\n.global-sidebar.collapsed {\r\n  width: 56px;\r\n  min-width: 56px;\r\n}\r\n\r\n.sidebar-header {\r\n  padding: 12px;\r\n  border-bottom: 1px solid var(--border-subtle);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.sidebar-brand-row {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n\r\n.brand-identity {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  overflow: hidden;\r\n}\r\n\r\n.brand-glyph {\r\n  width: 28px;\r\n  height: 28px;\r\n  min-width: 28px;\r\n  border-radius: 7px;\r\n  background: var(--accent);\r\n  color: #FFFFFF;\r\n  font-family: var(--font-mono);\r\n  font-weight: 700;\r\n  font-size: 13px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  letter-spacing: -0.03em;\r\n}\r\n\r\n.brand-titles {\r\n  display: flex;\r\n  flex-direction: column;\r\n  line-height: 1.2;\r\n  white-space: nowrap;\r\n}\r\n\r\n.brand-name {\r\n  font-size: 13.5px;\r\n  font-weight: 600;\r\n  letter-spacing: -0.02em;\r\n  color: var(--text-primary);\r\n}\r\n\r\n.brand-tag {\r\n  font-size: 11px;\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.project-switcher {\r\n  width: 100%;\r\n  padding: 6px 8px;\r\n  border-radius: var(--radius-btn);\r\n  border: 1px solid var(--border-subtle);\r\n  background: var(--surface-secondary);\r\n  color: var(--text-primary);\r\n  font-size: 12px;\r\n  font-weight: 500;\r\n  cursor: pointer;\r\n  outline: none;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.project-switcher:focus-visible {\r\n  border-color: var(--accent);\r\n  box-shadow: 0 0 0 2px var(--accent-border);\r\n}\r\n\r\n.sidebar-nav {\r\n  flex: 1;\r\n  padding: 10px 8px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.sidebar-section-label {\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n  color: var(--text-muted);\r\n  padding: 8px 10px 4px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.sidebar-link {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  height: 36px;\r\n  padding: 0 10px;\r\n  border-radius: var(--radius-btn);\r\n  border: 1px solid transparent;\r\n  background: transparent;\r\n  color: var(--text-secondary);\r\n  font-size: 13px;\r\n  font-weight: 500;\r\n  cursor: pointer;\r\n  text-align: left;\r\n  white-space: nowrap;\r\n  transition: background var(--dur-hover) var(--ease-ui), color var(--dur-hover) var(--ease-ui);\r\n}\r\n\r\n.sidebar-link:hover {\r\n  background: var(--surface-secondary);\r\n  color: var(--text-primary);\r\n}\r\n\r\n.sidebar-link.active {\r\n  background: var(--accent-soft);\r\n  color: var(--accent);\r\n  border-color: var(--accent-border);\r\n  font-weight: 600;\r\n}\r\n\r\n.sidebar-link-badge {\r\n  margin-left: auto;\r\n  font-family: var(--font-mono);\r\n  font-size: 10.5px;\r\n  padding: 1px 6px;\r\n  border-radius: 999px;\r\n  background: var(--surface-secondary);\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.sidebar-link.active .sidebar-link-badge {\r\n  background: var(--accent);\r\n  color: #FFFFFF;\r\n}\r\n\r\n.sidebar-footer {\r\n  padding: 10px 8px;\r\n  border-top: 1px solid var(--border-subtle);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.sidebar-status-card {\r\n  padding: 8px 10px;\r\n  border-radius: var(--radius-btn);\r\n  background: var(--surface-secondary);\r\n  border: 1px solid var(--border-subtle);\r\n  font-size: 11.5px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n/* 5.2 Global Topbar (54px height) */\r\n.shell-main-column {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n  height: 100vh;\r\n  overflow: hidden;\r\n}\r\n\r\n.global-topbar {\r\n  height: 54px;\r\n  min-height: 54px;\r\n  padding: 0 16px;\r\n  background: var(--surface-primary);\r\n  border-bottom: 1px solid var(--border-subtle);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  z-index: 30;\r\n}\r\n\r\n.topbar-left {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.breadcrumb-root {\r\n  font-size: 12.5px;\r\n  color: var(--text-secondary);\r\n  white-space: nowrap;\r\n}\r\n\r\n.breadcrumb-sep {\r\n  color: var(--border-strong);\r\n  font-size: 12px;\r\n}\r\n\r\n.breadcrumb-current {\r\n  font-size: 13.5px;\r\n  font-weight: 600;\r\n  color: var(--text-primary);\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.save-status-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  font-size: 11.5px;\r\n  color: var(--text-secondary);\r\n  padding: 2px 8px;\r\n  border-radius: 999px;\r\n  background: var(--surface-secondary);\r\n  border: 1px solid var(--border-subtle);\r\n  white-space: nowrap;\r\n}\r\n\r\n.status-dot {\r\n  width: 6px;\r\n  height: 6px;\r\n  border-radius: 50%;\r\n  background: var(--emerald-text);\r\n}\r\n\r\n.status-dot.amber {\r\n  background: var(--amber-text);\r\n}\r\n\r\n.topbar-right {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.topbar-metric {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 4px 10px;\r\n  border-radius: var(--radius-btn);\r\n  background: var(--surface-secondary);\r\n  border: 1px solid var(--border-subtle);\r\n  font-size: 12px;\r\n}\r\n\r\n.topbar-metric-label {\r\n  color: var(--text-secondary);\r\n  font-size: 11.5px;\r\n}\r\n\r\n.topbar-metric-value {\r\n  font-family: var(--font-mono);\r\n  font-weight: 600;\r\n  color: var(--text-primary);\r\n}\r\n\r\n/* ============================================================================\r\n   MAIN WORKSPACE & PERSISTENT STUDIO STAGE (SECTION 6)\r\n   ============================================================================ */\r\n.shell-stage {\r\n  flex: 1;\r\n  position: relative;\r\n  display: flex;\r\n  min-height: 0;\r\n  overflow: hidden;\r\n  background: var(--app-bg);\r\n}\r\n\r\n.workspace-layout {\r\n  display: flex;\r\n  width: 100%;\r\n  height: 100%;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.viewport-stage-wrapper {\r\n  flex: 1;\r\n  position: relative;\r\n  height: 100%;\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  background: var(--app-bg);\r\n  overflow: hidden;\r\n}\r\n\r\n/* Floating Compact Viewport Toolbar (Section 6.1) */\r\n.floating-viewport-bar {\r\n  position: absolute;\r\n  top: 12px;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  z-index: 20;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 4px 6px;\r\n  border-radius: var(--radius-card);\r\n  background: var(--surface-overlay);\r\n  border: 1px solid var(--border-subtle);\r\n  box-shadow: var(--shadow-sm);\r\n  max-width: calc(100% - 24px);\r\n  overflow-x: auto;\r\n  scrollbar-width: none;\r\n}\r\n\r\n.floating-viewport-bar::-webkit-scrollbar {\r\n  display: none;\r\n}\r\n\r\n.segmented-group {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  background: var(--surface-secondary);\r\n  padding: 2px;\r\n  border-radius: var(--radius-btn);\r\n  border: 1px solid var(--border-subtle);\r\n}\r\n\r\n.seg-btn {\r\n  padding: 4px 9px;\r\n  border-radius: 4px;\r\n  border: none;\r\n  background: transparent;\r\n  color: var(--text-secondary);\r\n  font-size: 12px;\r\n  font-weight: 500;\r\n  cursor: pointer;\r\n  white-space: nowrap;\r\n  transition: all var(--dur-hover) var(--ease-ui);\r\n}\r\n\r\n.seg-btn:hover {\r\n  color: var(--text-primary);\r\n}\r\n\r\n.seg-btn.active {\r\n  background: var(--surface-primary);\r\n  color: var(--text-primary);\r\n  box-shadow: var(--shadow-xs);\r\n  font-weight: 600;\r\n}\r\n\r\n.toolbar-divider {\r\n  width: 1px;\r\n  height: 18px;\r\n  background: var(--border-subtle);\r\n  margin: 0 2px;\r\n}\r\n\r\n/* Floating Bottom-Left & Bottom-Right HUD Overlays in 3D/2D Viewport */\r\n.viewport-hud-bottom-left {\r\n  position: absolute;\r\n  bottom: 14px;\r\n  left: 14px;\r\n  z-index: 18;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  pointer-events: none;\r\n}\r\n\r\n.viewport-hud-pill {\r\n  pointer-events: auto;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 5px 10px;\r\n  border-radius: var(--radius-btn);\r\n  background: var(--surface-overlay);\r\n  border: 1px solid var(--border-subtle);\r\n  box-shadow: var(--shadow-xs);\r\n  font-size: 11.5px;\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.xyz-gizmo-badge {\r\n  pointer-events: auto;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 5px 9px;\r\n  border-radius: var(--radius-btn);\r\n  background: var(--surface-overlay);\r\n  border: 1px solid var(--border-subtle);\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n}\r\n\r\n/* Collapsible Object & Material Inspector Dock (Section 6.3 & 11) */\r\n.inspector-dock {\r\n  width: 300px;\r\n  min-width: 300px;\r\n  height: 100%;\r\n  background: var(--surface-primary);\r\n  border-left: 1px solid var(--border-subtle);\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  transition: width var(--dur-panel) var(--ease-ui), min-width var(--dur-panel) var(--ease-ui);\r\n  z-index: 22;\r\n}\r\n\r\n/* AI Design Assistant Right Panel (Section 7) */\r\n.ai-assistant-dock {\r\n  width: 380px;\r\n  min-width: 380px;\r\n  height: 100%;\r\n  background: var(--surface-primary);\r\n  border-left: 1px solid var(--border-subtle);\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  z-index: 25;\r\n}\r\n\r\n/* ============================================================================\r\n   UI PRIMITIVES (BUTTONS, BADGES, CARDS, INPUTS, ACCORDIONS, DRAWERS)\r\n   ============================================================================ */\r\n.btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 6px;\r\n  height: 34px;\r\n  padding: 0 12px;\r\n  border-radius: var(--radius-btn);\r\n  border: 1px solid var(--border-subtle);\r\n  background: var(--surface-primary);\r\n  color: var(--text-primary);\r\n  font-family: var(--font-sans);\r\n  font-size: 12.5px;\r\n  font-weight: 500;\r\n  cursor: pointer;\r\n  white-space: nowrap;\r\n  text-decoration: none;\r\n  transition: transform var(--dur-hover) var(--ease-ui), background var(--dur-hover) var(--ease-ui), border-color var(--dur-hover) var(--ease-ui);\r\n}\r\n\r\n.btn:hover:not(:disabled) {\r\n  background: var(--surface-secondary);\r\n  border-color: var(--border-strong);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.btn:active:not(:disabled) {\r\n  transform: translateY(0) scale(0.985);\r\n}\r\n\r\n.btn:focus-visible {\r\n  outline: 2px solid var(--accent);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.btn:disabled {\r\n  opacity: 0.5;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.btn-primary {\r\n  background: var(--accent);\r\n  color: #FFFFFF;\r\n  border-color: var(--accent);\r\n}\r\n\r\n.btn-primary:hover:not(:disabled) {\r\n  background: var(--accent-hover);\r\n  border-color: var(--accent-hover);\r\n}\r\n\r\n.btn-soft {\r\n  background: var(--accent-soft);\r\n  color: var(--accent);\r\n  border-color: var(--accent-border);\r\n}\r\n\r\n.btn-soft:hover:not(:disabled) {\r\n  background: var(--accent);\r\n  color: #FFFFFF;\r\n}\r\n\r\n.btn-danger-outline {\r\n  color: var(--rose-text);\r\n  border-color: var(--rose-border);\r\n  background: var(--rose-bg);\r\n}\r\n\r\n.btn-sm {\r\n  height: 28px;\r\n  padding: 0 9px;\r\n  font-size: 12px;\r\n}\r\n\r\n.btn-icon {\r\n  width: 32px;\r\n  height: 32px;\r\n  padding: 0;\r\n}\r\n\r\n/* Status Badges */\r\n.status-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  padding: 2px 8px;\r\n  border-radius: 999px;\r\n  font-size: 11px;\r\n  font-weight: 500;\r\n  font-family: var(--font-mono);\r\n  border: 1px solid transparent;\r\n  white-space: nowrap;\r\n}\r\n\r\n.status-badge.teal {\r\n  background: var(--accent-soft);\r\n  color: var(--accent);\r\n  border-color: var(--accent-border);\r\n}\r\n\r\n.status-badge.emerald {\r\n  background: var(--emerald-bg);\r\n  color: var(--emerald-text);\r\n  border-color: var(--emerald-border);\r\n}\r\n\r\n.status-badge.amber {\r\n  background: var(--amber-bg);\r\n  color: var(--amber-text);\r\n  border-color: var(--amber-border);\r\n}\r\n\r\n.status-badge.rose {\r\n  background: var(--rose-bg);\r\n  color: var(--rose-text);\r\n  border-color: var(--rose-border);\r\n}\r\n\r\n.status-badge.neutral {\r\n  background: var(--surface-secondary);\r\n  color: var(--text-secondary);\r\n  border-color: var(--border-subtle);\r\n}\r\n\r\n/* Cards & Surfaces (4px grid spacing: 16-20px padding, 8-10px radius) */\r\n.surface-card {\r\n  background: var(--surface-primary);\r\n  border: 1px solid var(--border-subtle);\r\n  border-radius: var(--radius-card);\r\n  padding: 16px;\r\n  box-shadow: var(--shadow-xs);\r\n  transition: transform var(--dur-hover) var(--ease-ui), border-color var(--dur-hover) var(--ease-ui), box-shadow var(--dur-hover) var(--ease-ui);\r\n}\r\n\r\n.surface-card.interactive:hover {\r\n  transform: translateY(-2px);\r\n  border-color: var(--border-strong);\r\n  box-shadow: var(--shadow-sm);\r\n}\r\n\r\n.surface-card.selected {\r\n  border-color: var(--accent);\r\n  box-shadow: 0 0 0 1px var(--accent);\r\n}\r\n\r\n.surface-subtle {\r\n  background: var(--surface-secondary);\r\n  border: 1px solid var(--border-subtle);\r\n  border-radius: var(--radius-card);\r\n  padding: 12px;\r\n}\r\n\r\n/* Typography Helpers */\r\n.page-container {\r\n  flex: 1;\r\n  width: 100%;\r\n  height: 100%;\r\n  overflow-y: auto;\r\n  padding: 24px 28px;\r\n  background: var(--app-bg);\r\n}\r\n\r\n