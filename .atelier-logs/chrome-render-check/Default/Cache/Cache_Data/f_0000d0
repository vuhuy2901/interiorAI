		const duplicates = folderKeys.filter((key, i) => folderKeys.indexOf(key) !== i);
		if (duplicates.length > 0) {
			ctx.addIssue({
				code: z.ZodIssueCode.custom,
				message: `Duplicate local folder keys: ${[...new Set(duplicates)].join(", ")}`,
				path: ["localFolders"]
			});
		}
	}
