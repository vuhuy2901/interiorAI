# ==============================================================================
# ATELIER AI — Environment Configuration Example
# Copy this file to .env if you want to pre-configure external Cloud LLM API keys.
# Without external keys, ATELIER AI automatically uses the built-in
# Deterministic Architectural Concierge + Local Pascal MCP Server (@pascal-app/mcp).
# ==============================================================================

ATELIER_API_HOST=127.0.0.1
ATELIER_API_PORT=8000
ATELIER_WEB_PORT=5173

# Optional Cloud Model Providers (Can also be configured in Settings -> AI Connections UI)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Local Ollama Endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434
