{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Paperclip: Start on workspace open",
      "type": "shell",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\start-paperclip.ps1"],
      "runOptions": { "runOn": "folderOpen", "instanceLimit": 1 },
      "problemMatcher": [],
      "presentation": { "reveal": "never", "panel": "dedicated", "showReuseMessage": false, "close": true }
    }
  ]
}
